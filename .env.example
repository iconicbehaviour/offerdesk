# Run npm run setup to generate private values. Never commit your real .env.
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000
APP_PASSWORD=
SESSION_SECRET=
# 32 random bytes, base64-encoded; preserve this key when backing up encrypted Gmail tokens.
ENCRYPTION_KEY=
ADMIN_API_TOKEN=
SCHEDULER_TOKEN=
DATA_DIR=./data
SCHEDULE_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
# Choose an available Claude model in your own account.
ANTHROPIC_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional paid, manually invoked web discovery.
BRAVE_SEARCH_API_KEY=
BRAVE_COUNTRY=
