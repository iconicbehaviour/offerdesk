{
  "name": "offerdesk-starter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types server/index.ts",
    "build": "vite build",
    "start": "node --experimental-strip-types server/index.ts",
    "setup": "node scripts/setup.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "package:release": "node scripts/package-release.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
